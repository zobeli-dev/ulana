# Copy to .env and change what you need. Expo reads EXPO_PUBLIC_ variables
# when it starts, so restart `bun run web` (or ios, android) after a change.

# Where `ulana serve` runs. A phone needs this machine's address on the
# network, such as http://192.168.1.20:8790, and the server started with
# --bind 0.0.0.0:8790.
EXPO_PUBLIC_ULANA_URL=http://127.0.0.1:8790

# The OpenRouter model that writes views. Any chat model id from
# https://openrouter.ai/models works.
EXPO_PUBLIC_ULANA_MODEL=z-ai/glm-5.3-flash

# The OpenRouter key is not set here: connect it in the app's chat panel.
# It is kept on the device and sent only to OpenRouter.
